PORT=5173
BIND_HOST=0.0.0.0
NODE_ENV=production

# Render-specific configuration
# On Render, PORT is automatically set by the platform
# Use PORT=10000 for local testing of Render configuration

# Optional. Omit in production to keep Socket.IO same-origin only.
# CORS_ORIGIN=https://your-domain.example

# Optional dedicated TURN for strict NAT. Without it, a best-effort free
# public TURN (Metered Open Relay) is used as a fallback, which is usually
# enough for phone <-> laptop transfers across different networks.
# Vite inlines VITE_* at build time — after changing these, rebuild.
# Username/credential are optional (open TURN endpoints need neither).
# VITE_TURN_URL=turn:your-turn.example.com:3478,turns:your-turn.example.com:5349
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
